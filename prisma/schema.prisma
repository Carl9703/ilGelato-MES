generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Uzytkownicy {
  id                     String                     @id @default(uuid())
  login                  String                     @unique
  haslo                  String
  czy_aktywne            Boolean                    @default(true)
  utworzono_dnia         DateTime                   @default(now())
  zaktualizowano_dnia    DateTime                   @updatedAt
  dokumenty_anulowane    Dokumenty_Magazynowe[]     @relation("DokumentAnulowany")
  dokumenty_zatwierdzone Dokumenty_Magazynowe[]     @relation("DokumentZatwierdzony")
  dokumenty_utworzone    Dokumenty_Magazynowe[]     @relation("DokumentUtworzony")
  ruchy_magazynowe       Ruchy_Magazynowe[]
  ruchy_opakowan         Ruchy_Opakowan_Zwrotnych[]
}

model Kontrahenci {
  id                  String                     @id @default(uuid())
  kod                 String                     @unique
  nazwa               String
  adres               String?
  czy_aktywne         Boolean                    @default(true)
  utworzono_dnia      DateTime                   @default(now())
  zaktualizowano_dnia DateTime                   @updatedAt
  dokumenty           Dokumenty_Magazynowe[]
  ruchy_opakowan      Ruchy_Opakowan_Zwrotnych[]
}

model Dokumenty_Magazynowe {
  id                           String                @id @default(uuid())
  referencja                   String                @unique
  typ                          String
  status                       String                @default("Bufor")
  id_uzytkownika_utworzenia    String
  id_uzytkownika_zatwierdzenia String?
  id_uzytkownika_anulowania    String?
  id_kontrahenta               String?
  data_zatwierdzenia           DateTime?
  data_anulowania              DateTime?
  czy_aktywne                  Boolean               @default(true)
  utworzono_dnia               DateTime              @default(now())
  zaktualizowano_dnia          DateTime              @updatedAt
  pozycje_json                 String?
  numer_zewnetrzny             String?
  data_dostawy                 DateTime?
  kontrahent                   Kontrahenci?          @relation(fields: [id_kontrahenta], references: [id])
  uzytkownik_anulowania        Uzytkownicy?          @relation("DokumentAnulowany", fields: [id_uzytkownika_anulowania], references: [id])
  uzytkownik_zatwierdzenia     Uzytkownicy?          @relation("DokumentZatwierdzony", fields: [id_uzytkownika_zatwierdzenia], references: [id])
  uzytkownik_utworzenia        Uzytkownicy           @relation("DokumentUtworzony", fields: [id_uzytkownika_utworzenia], references: [id])
  opakowania_wz                Opakowania_Wyrobowe[]

  @@index([id_uzytkownika_utworzenia])
  @@index([id_uzytkownika_zatwierdzenia])
  @@index([id_uzytkownika_anulowania])
  @@index([id_kontrahenta])
  @@index([status])
}

model Asortyment {
  id                       String                     @id @default(uuid())
  kod_towaru               String                     @unique
  nazwa                    String
  typ_asortymentu          String
  jednostka_miary          String
  jednostka_pomocnicza     String?
  przelicznik_jednostki    Float?
  czy_wymaga_daty_waznosci Boolean                    @default(false)
  czy_zasob_nieograniczony Boolean                    @default(false)
  czy_aktywne              Boolean                    @default(true)
  producent                String?
  zrodlo_danych            String?
  skladniki_opis           String?
  moze_zawierac            String?
  id_grupy                 String?
  czy_zwrotne              Boolean                    @default(false)
  utworzono_dnia           DateTime                   @default(now())
  zaktualizowano_dnia      DateTime                   @updatedAt
  cena_sprzedazy           Float?
  stawka_vat               Float?
  cena_zakupu              Float?
  waga_jednostkowa_kg      Float?  // Waga 1 szt. dla produktów kubeczkowych/kanapkowych
  alergeny                 Alergeny_Asortymentu?
  grupa                    Grupy_Towarowe?            @relation(fields: [id_grupy], references: [id])
  opakowania_wyrobowe      Opakowania_Wyrobowe[]
  partie_magazynowe        Partie_Magazynowe[]
  receptury_docelowe       Receptury[]                @relation("AsortymentDocelowy")
  rezerwacje               Rezerwacje_Magazynowe[]
  ruchy_opakowan           Ruchy_Opakowan_Zwrotnych[]
  skladniki_receptury      Skladniki_Receptury[]      @relation("AsortymentSkladnika")
  wartosci_odzywcze        Wartosci_Odzywcze?

  @@index([id_grupy])
  @@index([typ_asortymentu])
}

model Grupy_Towarowe {
  id                  String           @id @default(uuid())
  kod                 String           @unique
  nazwa               String
  id_grupy_nadrzednej String?
  kolejnosc           Int              @default(0)
  czy_aktywne         Boolean          @default(true)
  utworzono_dnia      DateTime         @default(now())
  zaktualizowano_dnia DateTime         @updatedAt
  asortyment          Asortyment[]
  grupa_nadrzedna     Grupy_Towarowe?  @relation("GrupyHierarchia", fields: [id_grupy_nadrzednej], references: [id], onDelete: SetNull)
  podgrupy            Grupy_Towarowe[] @relation("GrupyHierarchia")

  @@index([id_grupy_nadrzednej])
}

model Wartosci_Odzywcze {
  id                  String     @id @default(uuid())
  id_asortymentu      String     @unique
  porcja_g            Float      @default(100)
  energia_kj          Float?
  energia_kcal        Float?
  tluszcz             Float?
  kwasy_nasycone      Float?
  weglowodany         Float?
  cukry               Float?
  blonnik             Float?
  bialko              Float?
  sol                 Float?
  utworzono_dnia      DateTime   @default(now())
  zaktualizowano_dnia DateTime   @updatedAt
  asortyment          Asortyment @relation(fields: [id_asortymentu], references: [id], onDelete: Cascade)
}

model Alergeny_Asortymentu {
  id                  String     @id @default(uuid())
  id_asortymentu      String     @unique
  gluten              Boolean    @default(false)
  skorupiaki          Boolean    @default(false)
  jaja                Boolean    @default(false)
  ryby                Boolean    @default(false)
  orzeszki_ziemne     Boolean    @default(false)
  soja                Boolean    @default(false)
  mleko               Boolean    @default(false)
  orzechy             Boolean    @default(false)
  seler               Boolean    @default(false)
  gorczyca            Boolean    @default(false)
  sezam               Boolean    @default(false)
  dwutlenek_siarki    Boolean    @default(false)
  lubin               Boolean    @default(false)
  mieczaki            Boolean    @default(false)
  utworzono_dnia      DateTime   @default(now())
  zaktualizowano_dnia DateTime   @updatedAt
  asortyment          Asortyment @relation(fields: [id_asortymentu], references: [id], onDelete: Cascade)
}

model Partie_Magazynowe {
  id                  String                  @id @default(uuid())
  id_asortymentu      String
  numer_partii        String                  @unique
  data_produkcji      DateTime?
  termin_waznosci     DateTime?
  status_partii       String
  czy_aktywne         Boolean                 @default(true)
  utworzono_dnia      DateTime                @default(now())
  zaktualizowano_dnia DateTime                @updatedAt
  opakowania_json     String?
  opakowania_baza     Opakowania_Wyrobowe[]
  asortyment          Asortyment              @relation(fields: [id_asortymentu], references: [id])
  pozycje_sesji_baza  Pozycje_Sesji_Gelato[]
  rezerwacje          Rezerwacje_Magazynowe[]
  ruchy_magazynowe    Ruchy_Magazynowe[]

  @@index([id_asortymentu])
  @@index([status_partii])
  @@index([termin_waznosci])
}

model Ruchy_Magazynowe {
  id                   String                @id @default(uuid())
  id_partii            String
  id_zlecenia          String?
  typ_ruchu            String
  ilosc                Float
  ilosc_faktyczna      Float?
  cena_jednostkowa     Float?
  waluta               String?               @default("PLN")
  referencja_dokumentu String?
  id_uzytkownika       String
  czy_aktywne          Boolean               @default(true)
  utworzono_dnia       DateTime              @default(now())
  zaktualizowano_dnia  DateTime              @updatedAt
  uzytkownik           Uzytkownicy           @relation(fields: [id_uzytkownika], references: [id])
  zlecenie             Zlecenia_Produkcyjne? @relation(fields: [id_zlecenia], references: [id])
  partia               Partie_Magazynowe     @relation(fields: [id_partii], references: [id])

  @@index([id_partii])
  @@index([referencja_dokumentu])
  @@index([id_zlecenia])
  @@index([czy_aktywne])
  @@index([id_uzytkownika])
  @@index([typ_ruchu])
}

model Receptury {
  id                        String                 @id @default(uuid())
  id_asortymentu_docelowego String
  numer_wersji              Int
  dni_trwalosci             Int?
  wielkosc_produkcji        Float                  @default(1)
  narzut_procent            Float                  @default(0)
  czy_aktywne               Boolean                @default(true)
  utworzono_dnia            DateTime               @default(now())
  zaktualizowano_dnia       DateTime               @updatedAt
  pozycje_sesji_gelato      Pozycje_Sesji_Gelato[]
  asortyment_docelowy       Asortyment             @relation("AsortymentDocelowy", fields: [id_asortymentu_docelowego], references: [id])
  skladniki                 Skladniki_Receptury[]
  zlecenia_produkcyjne      Zlecenia_Produkcyjne[]

  @@unique([id_asortymentu_docelowego, numer_wersji])
}

model Skladniki_Receptury {
  id                       String     @id @default(uuid())
  id_receptury             String
  id_asortymentu_skladnika String
  ilosc_wymagana           Float
  procent_strat            Float      @default(0)
  czy_pomocnicza           Boolean    @default(false)
  czy_aktywne              Boolean    @default(true)
  utworzono_dnia           DateTime   @default(now())
  zaktualizowano_dnia      DateTime   @updatedAt
  asortyment_skladnika     Asortyment @relation("AsortymentSkladnika", fields: [id_asortymentu_skladnika], references: [id])
  receptura                Receptury  @relation(fields: [id_receptury], references: [id], onDelete: Cascade)

  @@index([id_receptury])
  @@index([id_asortymentu_skladnika])
}

model Sesja_Robocza {
  id                  String              @id @default(uuid())
  krok                Int                 @default(1)
  dane_json           String
  nazwa               String?
  zaktualizowano_dnia DateTime            @updatedAt
  log                 Sesja_Robocza_Log[]
}

model Sesja_Robocza_Log {
  id                String        @id @default(uuid())
  id_sesji_roboczej String
  krok              Int
  zdarzenie         String
  dane_json         String
  utworzono_dnia    DateTime      @default(now())
  sesja_robocza     Sesja_Robocza @relation(fields: [id_sesji_roboczej], references: [id], onDelete: Cascade)
}

model Sesje_Produkcji {
  id                  String                 @id @default(uuid())
  numer_sesji         String                 @unique
  czy_aktywne         Boolean                @default(true)
  utworzono_dnia      DateTime               @default(now())
  zaktualizowano_dnia DateTime               @updatedAt
  data_produkcji      DateTime?
  typ                 String                 @default("lody") // "lody" | "sorbety" | "kubeczki" | "kanapki"
  zlecenia            Zlecenia_Produkcyjne[]
}

model Zlecenia_Produkcyjne {
  id                       String                  @id @default(uuid())
  numer_zlecenia           String?                 @unique
  id_receptury             String
  id_sesji                 String?
  etap                     Int?
  planowana_ilosc_wyrobu   Float
  rzeczywista_ilosc_wyrobu Float?
  opakowania_json          String?
  status                   String
  czy_aktywne              Boolean                 @default(true)
  utworzono_dnia           DateTime                @default(now())
  zaktualizowano_dnia      DateTime                @updatedAt
  rezerwacje               Rezerwacje_Magazynowe[]
  ruchy_magazynowe         Ruchy_Magazynowe[]
  sesja                    Sesje_Produkcji?        @relation(fields: [id_sesji], references: [id], onDelete: SetNull)
  receptura                Receptury               @relation(fields: [id_receptury], references: [id])

  @@index([id_receptury])
  @@index([id_sesji])
  @@index([status])
}

model Rezerwacje_Magazynowe {
  id                  String               @id @default(uuid())
  id_partii           String?
  id_asortymentu      String?
  id_zlecenia         String
  ilosc_zarezerwowana Float
  status              String               @default("Aktywna")
  czy_aktywne         Boolean              @default(true)
  utworzono_dnia      DateTime             @default(now())
  zaktualizowano_dnia DateTime             @updatedAt
  zlecenie            Zlecenia_Produkcyjne @relation(fields: [id_zlecenia], references: [id])
  asortyment          Asortyment?          @relation(fields: [id_asortymentu], references: [id])
  partia              Partie_Magazynowe?   @relation(fields: [id_partii], references: [id])

  @@index([id_zlecenia])
  @@index([status])
}

model Typy_Opakowan {
  id               String                @id @default(uuid())
  nazwa            String                @unique
  pojemnosc_min_kg Float                 @default(0)
  pojemnosc_max_kg Float                 @default(10)
  czy_aktywne      Boolean               @default(true)
  utworzono_dnia   DateTime              @default(now())
  opakowania       Opakowania_Wyrobowe[]
}

model Sesje_Produkcji_Gelato {
  id                  String                 @id @default(uuid())
  numer_sesji         String                 @unique
  data_sesji          DateTime
  status              String                 @default("Otwarta")
  notatki             String?
  id_uzytkownika      String
  czy_aktywne         Boolean                @default(true)
  utworzono_dnia      DateTime               @default(now())
  zaktualizowano_dnia DateTime               @updatedAt
  opakowania          Opakowania_Wyrobowe[]
  pozycje             Pozycje_Sesji_Gelato[]
}

model Pozycje_Sesji_Gelato {
  id                  String                 @id @default(uuid())
  id_sesji            String
  id_receptury        String
  id_partii_bazy      String?
  ilosc_bazy_kg       Float?
  liczba_wsadow       Int                    @default(1)
  surowce_json        String?
  uwagi               String?
  czy_aktywne         Boolean                @default(true)
  utworzono_dnia      DateTime               @default(now())
  zaktualizowano_dnia DateTime               @updatedAt
  opakowania          Opakowania_Wyrobowe[]
  partia_bazy         Partie_Magazynowe?     @relation(fields: [id_partii_bazy], references: [id], onDelete: SetNull)
  receptura           Receptury              @relation(fields: [id_receptury], references: [id])
  sesja               Sesje_Produkcji_Gelato @relation(fields: [id_sesji], references: [id], onDelete: Cascade)

  @@index([id_sesji])
  @@index([id_receptury])
  @@index([id_partii_bazy])
}

model Opakowania_Wyrobowe {
  id                  String                 @id @default(uuid())
  numer_serii         String                 @unique
  id_sesji            String
  id_pozycji_sesji    String?
  id_asortymentu      String
  id_typu_opakowania  String
  id_partii_bazy      String?
  waga_kg             Float
  data_produkcji      DateTime               @default(now())
  termin_waznosci     DateTime?
  status              String                 @default("Dostepne")
  id_dokumentu_wz     String?
  czy_aktywne         Boolean                @default(true)
  utworzono_dnia      DateTime               @default(now())
  zaktualizowano_dnia DateTime               @updatedAt
  dokument_wz         Dokumenty_Magazynowe?  @relation(fields: [id_dokumentu_wz], references: [id])
  partia_bazy         Partie_Magazynowe?     @relation(fields: [id_partii_bazy], references: [id])
  typ_opakowania      Typy_Opakowan          @relation(fields: [id_typu_opakowania], references: [id])
  asortyment          Asortyment             @relation(fields: [id_asortymentu], references: [id])
  pozycja_sesji       Pozycje_Sesji_Gelato?  @relation(fields: [id_pozycji_sesji], references: [id])
  sesja               Sesje_Produkcji_Gelato @relation(fields: [id_sesji], references: [id])

  @@index([id_sesji])
  @@index([id_pozycji_sesji])
  @@index([id_asortymentu])
  @@index([id_typu_opakowania])
  @@index([id_partii_bazy])
  @@index([id_dokumentu_wz])
}

model Ruchy_Opakowan_Zwrotnych {
  id                   String       @id @default(uuid())
  id_asortymentu       String
  ilosc                Int
  typ_ruchu            String
  id_kontrahenta       String?
  referencja_dokumentu String?
  uwagi                String?
  id_uzytkownika       String
  utworzono_dnia       DateTime     @default(now())
  uzytkownik           Uzytkownicy  @relation(fields: [id_uzytkownika], references: [id])
  kontrahent           Kontrahenci? @relation(fields: [id_kontrahenta], references: [id])
  asortyment           Asortyment   @relation(fields: [id_asortymentu], references: [id])

  @@index([id_asortymentu])
  @@index([id_kontrahenta])
  @@index([typ_ruchu])
  @@index([referencja_dokumentu])
  @@index([utworzono_dnia])
}
